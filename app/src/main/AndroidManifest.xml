<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Android 11+ package visibility. Without these declarations the app cannot see - let alone
        bind - the system speech recognition and text-to-speech services, and SpeechRecognizer
        fails with "not connected to the recognition service".
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AurioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_aurio_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_aurio_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aurio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aurio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.player.AurioAudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Digital assistant: once chosen in Settings, holding power opens an Aurio session -->
        <service
            android:name=".data.ai.assistant.AurioVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/aurio_voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".data.ai.assistant.AurioVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the assistant role; forwards to the device's real speech recognizer -->
        <service
            android:name=".data.ai.assistant.AurioRecognitionService"
            android:exported="true">
            <meta-data
                android:name="android.speech"
                android:resource="@xml/aurio_recognition_service" />
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <service
            android:name=".data.ai.AurioAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>

</manifest>